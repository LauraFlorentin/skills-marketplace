{
  "description": "Inject configured brand guidance before creating or editing branded assets.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/brand_guard.py"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
