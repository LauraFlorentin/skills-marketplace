#!/usr/bin/env bash
# =============================================================================
# HARNESS INIT SCRIPT — Generated by harness-engineer plugin
# Run at the start of EVERY agent session.
# This script MUST pass before any coding begins.
# =============================================================================
set -e

STATE_DIR=".harness/state"
mkdir -p "$STATE_DIR"

echo "=== HARNESS: Starting environment ==="

# ── 1. Install dependencies ───────────────────────────────────────────────────
# [CUSTOMIZE: uncomment the relevant lines for your stack]

# Node.js
# npm install --silent 2>/dev/null || true

# Python
# pip install -r requirements.txt -q 2>/dev/null || true

# ── 2. Kill any existing dev server ──────────────────────────────────────────
if [ -f "$STATE_DIR/dev-server.pid" ]; then
  OLD_PID=$(cat "$STATE_DIR/dev-server.pid" 2>/dev/null)
  [ -n "$OLD_PID" ] && kill "$OLD_PID" 2>/dev/null || true
fi

# ── 3. Start dev server ───────────────────────────────────────────────────────
# [CUSTOMIZE: replace with your actual start command and port]
DEV_PORT=[PORT]
DEV_COMMAND="[START_COMMAND]"  # e.g. "npm run dev" or "python manage.py runserver"

$DEV_COMMAND &> "$STATE_DIR/dev-server.log" &
DEV_PID=$!
echo "$DEV_PID" > "$STATE_DIR/dev-server.pid"

echo "Dev server starting (PID: $DEV_PID, port: $DEV_PORT)..."

# ── 4. Wait for server ready ──────────────────────────────────────────────────
MAX_WAIT=30
for i in $(seq 1 $MAX_WAIT); do
  if curl -s --max-time 2 "http://localhost:$DEV_PORT" > /dev/null 2>&1; then
    echo "Server ready after ${i}s"
    break
  fi
  if [ "$i" -eq "$MAX_WAIT" ]; then
    echo "ERROR: Server did not start within ${MAX_WAIT}s"
    echo "Check: cat $STATE_DIR/dev-server.log"
    exit 1
  fi
  sleep 1
done

# ── 5. Smoke test ─────────────────────────────────────────────────────────────
echo "Running smoke test..."

HTTP_STATUS=$(curl -s -o /dev/null -w "%{http_code}" --max-time 5 "http://localhost:$DEV_PORT")

if [ "$HTTP_STATUS" = "200" ] || [ "$HTTP_STATUS" = "301" ] || [ "$HTTP_STATUS" = "302" ]; then
  echo "✓ Smoke test passed (HTTP $HTTP_STATUS)"
else
  echo "✗ SMOKE TEST FAILED (HTTP $HTTP_STATUS)"
  echo "The app is not responding correctly."
  echo "Check: cat $STATE_DIR/dev-server.log"
  exit 1
fi

# ── 6. Summary ────────────────────────────────────────────────────────────────
echo ""
echo "=== HARNESS: Environment ready ==="
echo "  App:    http://localhost:$DEV_PORT"
echo "  Logs:   $STATE_DIR/dev-server.log"
echo "  PID:    $DEV_PID"
echo ""
echo "Next: read claude-progress.txt, then features.json, then start coding."
